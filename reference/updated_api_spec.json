      "post": {
        "tags": [
          "Misc"
        ],
        "summary": "Validate Merchant Credentials API",
        "description": "Validate merchant credentials for API access",
        "operationId": "ValidateMerchantCredentials",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "",
            "required": true,
            "style": "simple",
            "schema": {
              "const": "application/x-www-form-urlencoded",
              "type": "string",
              "examples": [
                "application/x-www-form-urlencoded"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "encoding": {},
              "schema": {
                "required": [
                  "client_id",
                  "username",
                  "password"
                ],
                "type": "object",
                "properties": {
                  "client_id": {
                    "type": "string",
                    "description": "Client ID provided by PayU during onboarding",
                    "examples": [
                      "6f8bb4951e030d4d7349e64a144a534778673585f86039617c167166e9154f7e"
                    ]
                  },
                  "username": {
                    "type": "string",
                    "description": "Registered mobile number or Email ID"
                  },
                  "password": {
                    "type": "string",
                    "description": "Registered account password"
                  }
                },
                "contentMediaType": "application/x-www-form-urlencoded"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful validation",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "examples": [
                        "success"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "examples": [
                        "Credentials validated successfully"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "examples": [
                        "error"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "examples": [
                        "Invalid credentials"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      },
      "parameters": []
    }
