  "paths": {
    "/_payment": {
      "post": {
        "tags": [
          "Misc"
        ],
        "summary": "Cards Decoupled Flow",
        "description": "Collect Payment API with PayU Hosted Checkout integration",
        "operationId": "CollectPaymentAPI-S2S",
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "",
            "required": true,
            "style": "simple",
            "schema": {
              "const": "application/x-www-form-urlencoded",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "encoding": {},
              "schema": {
                "required": [
                  "key",
                  "txnid",
                  "amount",
                  "productinfo",
                  "firstname",
                  "email",
                  "phone",
                  "surl",
                  "furl",
                  "hash",
                  "pg",
                  "bankcode",
                  "txn_s2s_flow"
                ],
                "type": "object",
                "properties": {
                  "key": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/key"
                      },
                      {
                        "description": "This parameter must contain the merchant key provided by PayU."
                      }
                    ]
                  },
                  "txnid": {
                    "type": "integer",
                    "description": "The transaction ID is a reference number for a specific order that is generated by the merchant. It is used to track the order and must be unique. PayU's system will not accept duplicate transaction IDs.",
                    "contentEncoding": "int32",
                    "examples": [
                      123456787
                    ]
                  },
                  "amount": {
                    "type": "number",
                    "description": "This field should contain the payment amount for the transaction.",
                    "contentEncoding": "double",
                    "examples": [
                      100
                    ]
                  },
                  "productinfo": {
                    "type": "string",
                    "description": "This field should be a string containing a brief description of the product.",
                    "examples": [
                      "qwertyuiopasdfghjkl"
                    ]
                  },
                  "firstname": {
                    "type": "string",
                    "description": "The first name of the customer.",
                    "examples": [
                      "Ashish"
                    ]
                  },
                  "email": {
                    "type": "string",
                    "description": "The email address of the customer.",
                    "examples": [
                      "test@test.com"
                    ]
                  },
                  "phone": {
                    "type": "integer",
                    "description": "The phone number of the customer.",
                    "contentEncoding": "int64",
                    "examples": [
                      9069485355
                    ]
                  },
                  "surl": {
                    "type": "string",
                    "description": "The \"surl\" field is the success URL, which is the page PayU will redirect to if the transaction is successful. The merchant can handle the response at this URL after the customer is redirected there.",
                    "examples": [
                      "https://apiplayground-response.herokuapp.com/"
                    ]
                  },
                  "furl": {
                    "type": "string",
                    "description": "The \"furl\" field is the Failure URL, which is the page PayU will redirect to if the transaction is failed. The merchant can handle the response at this URL after the customer is redirected there.",
                    "examples": [
                      "https://apiplayground-response.herokuapp.com/"
                    ]
                  },
                  "hash": {
                    "type": "string",
                    "description": "It is used to avoid the possibility of transaction tampering. Hash formula: sha512(key|txnid|amount|productinfo|firstname|email|udf1|udf2|udf3|udf4|udf5|||||||SALT)"
                  },
                  "pg": {
                    "type": "string",
                    "description": "The pg parameter determines which payment tabs will be displayed on the PayU page. For example, if 'pg' = 'NB', the Net Banking tab will be displayed. If no value is specified for this parameter 'CC' will be takes as default value",
                    "examples": [
                      "CC"
                    ]
                  },
                  "bankcode": {
                    "type": "string",
                    "description": "Each payment option is identified with a unique bank code at PayU. The merchant must post this parameter with the corresponding payment option’s bank code value in it.",
                    "examples": [
                      "AMEX"
                    ]
                  },
                  "txn_s2s_flow": {
                    "const": "4",
                    "type": "string",
                    "description": "This parameter must be passed with the value as 4 for Cards Decoupled flow."
                  },
                  "ccnum": {
                    "type": "string",
                    "description": "Use 13-19 digit card number for credit/debit cards (15 digits for AMEX, 13-19 for Maestro) and validate with LUHN algorithm. Use only test cards as in the example or that is listed in Test Cards, UPI ID and Wallets section.."
                  },
                  "ccvv": {
                    "type": "string",
                    "description": "Use 3-digit CVV number for credit/debit cards and 4-digit security code (4DBC/CID) for AMEX cards. Validate with BIN API."
                  },
                  "ccname": {
                    "type": "string",
                    "description": "String This parameter must contain the name on card – as entered by the customer for the transaction."
                  },
                  "ccexpmon": {
                    "type": "string",
                    "description": "This parameter must contain the card’s expiry month – as entered by the user for the transaction. It must always be in 2 digits or in MM format. For months 1-9, this parameter must be appended with 0 – like 01, 02…09. For months 10-12, this parameter must not be appended – It should be 10,11 and 12 respectively.",
                    "examples": [
                      "05"
                    ]
                  },
                  "ccexpyr": {
                    "type": "string",
                    "description": "This parameter must contain the card’s expiry year – as entered by the customer for the transaction. It must be of four digits. Use 2025 in this field for Test environment.",
                    "examples": [
                      "2025"
                    ]
                  },
                  "lastname": {
                    "type": "string",
                    "description": "Last name of the customer (must only contains alphabets).",
                    "examples": [
                      "Singh"
                    ]
                  },
                  "curl": {
                    "type": "string",
                    "description": "The \"curl\" field is the Cancel URL, which is the page PayU will redirect to if the transaction is canceled by the customer. The merchant can handle the response at this URL after the customer is redirected there."
                  },
                  "buyer_type_business": {
                    "type": "string",
                    "description": "This parameter is used to identify whether it is a B2B transaction. If 1 is posted, it is a B2B transaction.",
                    "default": "0",
                    "examples": [
                      "1"
                    ]
                  },
                  "udf1": {
                    "type": "string",
                    "description": "User-defined fields (udf) are used to store any information corresponding to a particular transaction. You can use up to five udfs in the post designated as udf1, udf2, udf3, udf4, udf5.",
                    "examples": [
                      "iPhone"
                    ]
                  },
                  "udf2": {
                    "type": "string",
                    "description": "User-defined fields (udf) are used to store any information corresponding to a particular transaction. You can use up to five udfs in the post designated as udf1, udf2, udf3, udf4, udf5."
                  },
                  "udf3": {
                    "type": "string",
                    "description": "User-defined fields (udf) are used to store any information corresponding to a particular transaction. You can use up to five udfs in the post designated as udf1, udf2, udf3, udf4, udf5."
                  },
                  "udf4": {
                    "type": "string",
                    "description": "User-defined fields (udf) are used to store any information corresponding to a particular transaction. You can use up to five udfs in the post designated as udf1, udf2, udf3, udf4, udf5."
                  },
                  "udf5": {
                    "type": "string",
                    "description": "User-defined fields (udf) are used to store any information corresponding to a particular transaction. You can use up to five udfs in the post designated as udf1, udf2, udf3, udf4, udf5."
                  },
                  "auth_only": {
                    "type": "string",
                    "description": "This parameter must be passed with the value as 1 for this parameter.",
                    "default": "1"
                  },
                  "authentication_flow": {
                    "type": "string",
                    "description": "This parameter must be passed with value as REDIRECT.",
                    "default": "REDIRECT"
                  },
                  "termUrl": {
                    "type": "string",
                    "description": "This parameter must contain the URL which will receive the authentication response from ACS."
                  },
                  "s2s_device_info": {
                    "type": "string",
                    "description": "This parameter must have the customer agent’s device."
                  },
                  "s2s_client_ip": {
                    "type": "string",
                    "description": "This parameter must have the user agent of device."
                  },
                  "panNumber": {
                    "type": "string",
                    "description": "PAN number of the customer required in Cardless EMI flow."
                  }
                },
                "contentMediaType": "application/x-www-form-urlencoded"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {},
            "content": {}
          }
        },
        "deprecated": false
      },
      "parameters": []
    }
  },
