  "components": {
    "schemas": {
      "var1": {
        "title": "var1",
        "required": [
          "amount",
          "txnid",
          "productinfo",
          "firstname",
          "email",
          "phone"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "description": "This parameter contains the payment amount of the particular transaction."
          },
          "txnid": {
            "type": "string",
            "description": "This parameter contains the merchant-generated transaction number which is used to track a particular order (must be unique every time if already successful, otherwise you get an error of the duplicate transaction)."
          },
          "productinfo": {
            "type": "string",
            "description": "This parameter contains the product Description."
          },
          "firstname": {
            "type": "string",
            "description": "This parameter contains the first name of the customer."
          },
          "email": {
            "type": "string",
            "description": "This parameter contains the email address of the customer."
          },
          "phone": {
            "type": "string",
            "description": "This parameter contains the phone number of the customer."
          },
          "address1": {
            "type": "string",
            "description": "This parameter contains the first line of the billing address."
          },
          "city": {
            "type": "string",
            "description": "This parameter contains the city where the customer resides."
          },
          "state": {
            "type": "string",
            "description": "This parameter contains the state where the customer resides."
          },
          "country": {
            "type": "string",
            "description": "This parameter contains the country where the customer resides."
          },
          "zipcode": {
            "type": "string",
            "description": "This parameter contains the zip code of the customer's address."
          },
          "template_id": {
            "type": "string",
            "description": "This parameter contains the template ID to be provided in case of more than one email invoice template. Merchant can decide which template to use and provide the particular template ID in this parameter."
          },
          "validation_period": {
            "type": "integer",
            "description": "This parameter contains the number of days for which the email invoice usage is valid (If this field is left empty, the default value will be taken as 7 days).",
            "contentEncoding": "int32"
          },
          "send_email_now": {
            "type": "string",
            "description": "This parameter contains the flag to specify whether the email invoice needs to be sent to customer at the time of creation or later."
          },
          "send_sms": {
            "type": "string",
            "description": "This parameter contains the flag to specify whether the SMS invoice needs to be sent to customer."
          },
          "time_unit": {
            "type": "string",
            "description": "This parameter contains the any of the following time unit of validation period: M: Minute,, H: Hour or D: Days",
            "examples": [
              "H"
            ]
          }
        },
        "examples": [
          {
            "amount": "10000",
            "txnid": "abaac3330",
            "productinfo": "iPhone",
            "firstname": "Samir",
            "email": "test@test.com",
            "phone": "7401099153",
