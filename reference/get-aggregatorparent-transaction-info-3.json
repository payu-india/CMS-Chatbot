{
  "openapi": "3.1.0",
  "info": {
    "title": "Get Aggregator/Parent Transaction Info",
    "contact": {},
    "version": "1.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "https://test.payu.in/merchant",
      "variables": {}
    }
  ],
  "paths": {
    "/postservice": {
      "parameters": []
    }
  },
  "components": {
    "schemas": {
      "useCase": {
        "title": "useCase",
        "type": "object",
        "properties": {
          "getExtendedPaymentDetails": {
            "type": "string",
            "description": "This flag is posted as true to check EMI eligibility based on mobile number and/or card number depending on the payment method used. Also, checks the eligibility for “Buy Now Pay Later” payment modes.",
            "examples": [
              "true"
            ]
          },
          "getAdditionalCharges": {
            "type": "string",
            "description": "This flag is posted as true to return the additional charges configured for all payment options.",
            "examples": [
              "true"
            ]
          },
          "getTaxSpecification": {
            "type": "string",
            "description": "This flag is posted as true to returns the tax specification configured on the backend. Clients can use the result to show the split of additional charges for each payment option.",
            "examples": [
              "true"
            ]
          },
          "checkDownStatus": {
            "type": "string",
            "description": "This flag is posted as true to return the downtime of the payment options.",
            "examples": [
              "true"
            ]
          }
        }
      },
      "var1": {
        "title": "var1",
        "required": [
          "requestId",
          "transactionDetails",
          "usecase"
        ],
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "This parameter must contain the request ID."
          },
          "transactionDetails": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TransactionDetails"
              },
              {}
            ]
          },
          "usecase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/useCase"
              },
              {}
            ]
          }
        }
      },
      "Filters": {
        "title": "Filters",
        "required": [
          "paymentOptions"
        ],
        "type": "object",
        "properties": {
          "paymentOptions": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PaymentOptions"
              },
              {}
            ]
          }
        },
        "examples": [
          {
            "paymentOptions": {
              "emi": {
                "dc": "ICIC"
              }
            }
          }
        ]
      },
      "command": {
        "title": "command",
        "const": "get_checkout_details",
        "type": "string",
        "description": "This parameter must contain the command as get_checkout_details.",
        "examples": [
          "get_checkout_details"
        ]
      },
      "Content-Type": {
        "title": "Content-Type",
        "const": "application/x-www-form-urlencoded",
        "type": "string",
        "examples": [
          "application/x-www-form-urlencoded"
        ]
      },
      "TransactionDetails": {
        "title": "TransactionDetails",
        "required": [
          "amount",
          "txnid"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "description": "This field contains the transaction amount.",
            "examples": [
              "100.00"
            ]
          },
          "txnid": {
            "type": "string",
            "description": "This fields contains the transaction ID."
          }
        }
      },
      "key": {
        "title": "key",
        "const": "JPM7Fg",
        "type": "string",
        "description": "This parameter must contain merchant key provided by PayU.",
        "examples": [
          "JPM7Fg"
        ]
      },
      "PaymentOptions": {
        "title": "PaymentOptions",
        "required": [
          "emi"
        ],
        "type": "object",
        "properties": {
          "emi": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Emi"
              },
              {}
            ]
          }
        },
        "examples": [
          {
            "emi": {
              "dc": "ICIC"
            }
          }
        ]
      },
      "UseCase2": {
        "title": "UseCase2",
        "required": [
          "checkCustomerEligibility"
        ],
        "type": "object",
        "properties": {
          "checkCustomerEligibility": {
            "type": "boolean"
          }
        }
      },
      "Emi": {
        "title": "Emi",
        "required": [
          "dc"
        ],
        "type": "object",
        "properties": {
          "dc": {
            "type": "string"
          }
        },
        "examples": [
          {
            "dc": "ICIC"
          }
        ]
      },
      "form": {
        "title": "form",
        "const": 2,
        "type": "integer",
        "examples": [
          2
        ]
      },
      "command1": {
        "title": "command1",
        "const": "get_aggregator_transactions",
        "type": "string",
        "description": "This parameter must contain the command as \"get_aggregator_transactions.\""
      },
      "key1": {
        "title": "key1",
        "const": "JPM7Fg",
        "type": "string",
        "description": "This parameter must contain the parent merchant’s key."
      }
    }
  },
  "tags": [
    {
      "name": "Misc",
      "description": ""
    }
  ],
  "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
  }
}