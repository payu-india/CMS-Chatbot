        "summary": "get_checkout_details API",
        "description": "Generated from cURL: curl --request POST \\\n     --url https://test.payu.in/merchant/postservice.php \\\n     --header 'accept: application/json' \\\n     --header 'content-type: application/x-www-form-urlencoded' \\\n     --data key=JPM7Fg \\\n     --data command=get_checkout_details \\\n     --data 'var1={\"transactionDetails\":{\"amount\":\"100.00\",\"txnid\":\"asdusucbshb\"},\"usecase\":{\"checkDownStatus\":\"true\"},\"requestId\":\"yegdyyshds\"}' \\\n     --data hash=hash",
        "operationId": "get_checkout_details_API",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
