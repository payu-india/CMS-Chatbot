{
  "openapi": "3.1.0",
  "info": {
    "title": "Others",
    "contact": {},
    "version": "1.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "https://test.payu.in/merchant",
      "variables": {}
    }
  ],
  "paths": {
    "/postservice.php": {
      "parameters": []
    }
  },
  "components": {
    "schemas": {
      "var1": {
        "title": "var1",
        "required": [
          "requestId",
          "transactionDetails",
          "usecase"
        ],
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "This parameter must contain the request ID."
          },
          "transactionDetails": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TransactionDetails"
              },
              {}
            ]
          },
          "usecase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/useCase"
              },
              {}
            ]
          }
        }
      },
      "TransactionDetails": {
        "title": "TransactionDetails",
        "required": [
          "amount",
          "txnid"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "description": "This field contains the transaction amount.",
            "examples": [
              "100.00"
            ]
          },
          "txnid": {
            "type": "string",
            "description": "This fields contains the transaction ID."
          }
        }
      },
      "useCase": {
        "title": "useCase",
        "type": "object",
        "properties": {
          "getExtendedPaymentDetails": {
            "type": "string",
            "description": "This flag is posted as true to check EMI eligibility based on mobile number and/or card number depending on the payment method used. Also, checks the eligibility for “Buy Now Pay Later” payment modes.",
            "examples": [
              "true"
            ]
          },
          "getAdditionalCharges": {
            "type": "string",
            "description": "This flag is posted as true to return the additional charges configured for all payment options.",
            "examples": [
              "true"
            ]
          },
          "getTaxSpecification": {
            "type": "string",
            "description": "This flag is posted as true to returns the tax specification configured on the backend. Clients can use the result to show the split of additional charges for each payment option.",
            "examples": [
              "true"
            ]
          },
          "checkDownStatus": {
            "type": "string",
            "description": "This flag is posted as true to return the downtime of the payment options.",
            "examples": [
              "true"
            ]
          },
          "checkCustomerEligibility": {
            "type": "string",
            "description": "This flag is posted as true to check the customer eligibility.",
            "examples": [
              "true"
            ]
          },
          "filters": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Filters"
              },
              {}
            ]
          }
        }
      },
      "Filters": {
        "title": "Filters",
        "required": [
          "paymentOptions"
        ],
        "type": "object",
        "properties": {
          "paymentOptions": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PaymentOptions"
              },
              {}
            ]
          }
        },
        "examples": [
          {
            "paymentOptions": {
              "emi": {
                "dc": "ICIC"
              }
            }
          }
        ]
      },
      "PaymentOptions": {
        "title": "PaymentOptions",
        "type": "object",
        "properties": {
          "emi": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Emi"
              },
              {}
            ]
          },
          "bnpl": {
            "type": "string",
            "description": "This parameter must contain the list of banks or financial institutions for which eligibility check is regard. Include \"all\" for all the banks.",
            "examples": [
              "lazypay"
            ]
          }
        }
      },
      "Emi": {
        "title": "Emi",
        "type": "object",
        "properties": {
          "dc": {
            "type": "string",
            "description": "This parameter must contain the list of banks for which eligibility check is regard. Include \"all\" for all the banks.",
            "examples": [
              "ICIC"
            ]
          },
          "cc": {
            "type": "string",
            "description": "This parameter must contain the list of banks for which eligibility check is regard. Include \"all\" for all the banks.",
            "examples": [
              "ICIC"
            ]
          },
          "cardless": {
            "type": "string",
            "description": "This parameter must contain the list of banks for which eligibility check is regard. Include \"all\" for all the banks.",
            "examples": [
              "ICIC"
            ]
          }
        }
      },
      "UseCase2": {
        "title": "UseCase2",
        "required": [
          "checkCustomerEligibility"
        ],
        "type": "object",
        "properties": {
          "checkCustomerEligibility": {
            "type": "boolean"
          }
        }
      },
      "command": {
        "title": "command",
        "const": "get_checkout_details",
        "type": "string",
        "description": "This parameter must contain the command as get_checkout_details.",
        "examples": [
          "get_checkout_details"
        ]
      },
      "Content-Type": {
        "title": "Content-Type",
        "const": "application/x-www-form-urlencoded",
        "type": "string",
        "examples": [
          "application/x-www-form-urlencoded"
        ]
      },
      "form": {
        "title": "form",
        "const": 2,
        "type": "integer",
        "examples": [
          2
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Misc",
      "description": ""
    }
  ]
}