  "paths": {
    "/v3/merchants": {
      "post": {
        "tags": [
          "Create and Update a merchant"
        ],
        "summary": "CreateMerchant",
        "operationId": "CreateMerchant",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "encoding": {},
              "schema": {
                "required": [
                  "merchant[display_name]",
                  "merchant[email]",
                  "merchant[mobile]",
                  "merchant[business_details][business_entity_type]",
                  "merchant[business_details][pan]",
                  "merchant[signing_authority_details][pancard_number]",
                  "merchant[business_details][pancard_name]"
                ],
                "type": "object",
                "properties": {
                  "merchant[display_name]": {
                    "type": "string",
                    "description": "The merchant's name",
                    "examples": [
                      "Ashish Kumar"
                    ]
                  },
                  "merchant[email]": {
                    "type": "string",
                    "description": "Merchant's email address",
                    "examples": [
                      "ashish13@gmail.com"
                    ]
                  },
                  "merchant[mobile]": {
                    "type": "integer",
                    "description": "Merchant's phone number",
                    "contentEncoding": "int64",
                    "examples": [
                      9916965913
                    ]
                  },
                  "merchant[business_details][business_entity_type]": {
                    "type": "string",
                    "description": "Business entity type",
                    "examples": [
                      "Sole Proprietorship"
                    ]
                  },
                  "merchant[business_details][pan]": {
                    "type": "string",
                    "description": "Merchant's PAN number",
                    "examples": [
                      "FANPS6362D"
                    ]
                  },
                  "merchant[signing_authority_details][pancard_number]": {
                    "type": "string",
                    "description": "Signing authority's PAN number",
                    "examples": [
                      "FANPS6362D"
                    ]
                  },
                  "merchant[business_details][registered_name]": {
                    "type": "string",
                    "description": "Registered business name",
                    "examples": [
                      "DIVY HARESHKUMAR SHAH"
                    ]
                  },
                  "merchant[business_details][business_category]": {
                    "type": "string",
                    "description": "Business category",
                    "examples": [
                      "Arts, Gifts & Stationery"
                    ]
                  },
                  "merchant[business_details][business_sub_category]": {
                    "type": "string",
                    "description": "Subcategory of the business",
                    "examples": [
                      "Art Dealers and Galleries"
                    ]
                  },
                  "merchant[business_details][pancard_name]": {
                    "type": "string",
                    "description": "Name on the merchant's PAN card",
                    "examples": [
                      "DIVY HARESHKUMAR SHAH"
                    ]
                  },
                  "gst_number": {
                    "type": "string",
                    "description": "Merchant's GST number",
                    "examples": [
                      "24FANPS6362D1ZE"
                    ]
                  },
                  "merchant[business_address][addr_line1]": {
                    "type": "string",
                    "description": "Business address line"
                  },
                  "merchant[business_address][pin]": {
                    "type": "string",
                    "description": "PIN code of the business address"
                  },
                  "merchant[bank_details][account_no]": {
                    "type": "integer",
                    "description": "Merchant's bank account number",
                    "contentEncoding": "int64",
                    "examples": [
                      919010067278549
                    ]
                  },
                  "merchant[bank_details][ifsc_code]": {
                    "type": "string",
                    "description": "IFSC code",
                    "examples": [
                      "UTIB0003557"
                    ]
                  },
                  "merchant[bank_details][account_holder_name]": {
                    "type": "string",
                    "description": "Name of the bank account holder",
                    "examples": [
                      "DIVY HARESHKUMAR SHAH"
                    ]
                  },
                  "merchant[website_details][website_url]": {
                    "type": "string",
                    "description": "Merchant's website",
                    "examples": [
                      "https://www.google.com"
                    ]
                  },
                  "merchant[website_details][android_url]": {
                    "type": "string",
                    "description": "Android app URL (if applicable)"
                  },
                  "merchant[website_details][ios_url]": {
                    "type": "string",
                    "description": "iOS app URL (if applicable)"
                  },
                  "merchant[monthly_expected_volume]": {
                    "type": "integer",
                    "description": "Expected monthly transaction volume of the merchant",
                    "contentEncoding": "int32",
                    "examples": [
                      12000
                    ]
                  },
                  "merchant[signing_authority_details][name]": {
                    "type": "string",
                    "description": "Name of the signing authority",
                    "examples": [
                      "DIVY HARESHKUMAR SHAH"
                    ]
                  },
                  "merchant[signing_authority_details][email]": {
                    "type": "string",
                    "description": "Email of the signing authority",
                    "examples": [
                      "email_test1213@yopmail.com"
                    ]
                  },
                  "merchant[signing_authority_details][cin_number]": {
                    "type": "string",
                    "description": "CIN number of the signing authority"
                  },
                  "custom_parameters": {
                    "type": "string",
                    "description": "Custom configurations (array of objects)"
                  },
                  "attached_configs": {
                    "type": "string",
                    "description": "List of configurations for the reseller"
                  },
                  "director1_details": {
                    "type": "string",
                    "description": "Name and email of the first director (array format)"
                  },
                  "director2_details": {
                    "type": "string",
                    "description": "Name and email of the second director (array format)"
                  },
                  "product": {
                    "type": "string",
                    "description": "Company product name"
                  }
                },
                "contentMediaType": "application/x-www-form-urlencoded"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {}
          }
        },
        "deprecated": false,
        "servers": [
          {
            "url": "https://uat-partner.payu.in/api/v3",
            "variables": {}
          }
        ]
      },
      "parameters": []
    }
