{
  "openapi": "3.0.0",
  "info": {
    "title": "Settlement Devguide API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://test.payu.in"
    },
    {
      "url": "http://127.0.0.1:8090"
    },
    {
      "url": "https://test.payu.in"
    }
  ],
  "paths": {
    "/treasury/int/payu/settlement/settlementDetails": {
      "get": {
        "tags": [
          "default"
        ],
        "summary": "Settlement Details API",
        "description": "This API retrieves settlement details that the bank needs to settle. The input can be either the settlement date or a Unique Transaction Reference (UTR) number.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "HMAC SHA512 authorization header built from merchant_key and merchant_secret (required). Format: hmac username=\"<merchant_key>\", algorithm=\"sha512\", headers=\"date\", signature=\"<hex_sha512_hash>\"",
            "example": "{{authorization}}"
          },
          {
            "name": "Date",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Request timestamp used in signature (required). Format: Wed, 28 Jun 2023 11:25:19 GMT",
            "example": "{{date}}"
          },
          {
            "name": "mid",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Merchant identifier (required). Example: 135670",
            "example": "{{mid}}"
          },
          {
            "name": "settledOn",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Settlement date to query in YYYY-MM-DD format (required if UTR not provided). Date must be <= today.",
            "example": "{{settledOn}}"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Page number for paginated response (required).",
            "example": "{{page}}"
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Number of records per page (required). Must be between 2000 and 50000.",
            "example": "{{pageSize}}"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Result type filter (optional). Accepts 'G' or left blank.",
            "example": "{{type}}"
          },
          {
            "name": "isVersion",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "API version selector (optional). Valid values 1 or 2.",
            "example": "{{isVersion}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/settlement/range/": {},
    "/settlement/v1/merchantUpcomingSettlement": {
      "get": {
        "tags": [
          "default"
        ],
        "summary": "Merchant Upcoming And Pending Settlement API",
        "description": "This API retrieves upcoming and pending settlement information for the merchant. No query parameters or request body required.",
        "parameters": [
          {
            "name": "mid",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Merchant identifier the integration was registered with (mandatory). Can be string or integer.",
            "example": "{{mid}}"
          },
          {
            "name": "Accept",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Response content type (recommended). Should be 'application/json'.",
            "example": "application/json"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/settlement/transactionDetails": {
      "get": {
        "tags": [
          "default"
        ],
        "summary": "Transaction Details API",
        "description": "This API retrieves detailed transaction information for settlement reconciliation purposes using your merchant transaction ID.",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Bearer token for authentication (required). Format: 'Bearer <token>'",
            "example": "{{authorizationBearer}}"
          },
          {
            "name": "mid",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Your Merchant ID (required). Can be integer or string.",
            "example": "{{mid}}"
          },
          {
            "name": "Accept",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Response content type (recommended). Should be 'application/json'.",
            "example": "application/json"
          },
          {
            "name": "merchantTransactionId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Your unique merchant transaction/reference ID used to look up settlement entries (required). Length: 1-100 characters.",
            "example": "{{merchantTransactionId}}"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        },
        "operationId": "get_settlement-transactiondetails"
      }
    }
  }
}