{
  "openapi": "3.1.0",
  "info": {
    "title": "TPV",
    "contact": {},
    "version": "1.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "https://test.payu.in/",
      "variables": {}
    }
  ],
  "paths": {
    "/_payment": {
      "parameters": []
    }
  },
  "components": {
    "schemas": {
      "beneficiarydetail": {
        "title": "beneficiarydetail",
        "required": [
          "beneficiaryAccountNumber",
          "ifscCode"
        ],
        "type": "object",
        "properties": {
          "beneficiaryAccountNumber": {
            "type": "string",
            "description": "One or more beneficiary account number is appended using a pipe separator (|)",
            "examples": [
              "6612262775|323132312|2323123"
            ]
          },
          "ifscCode": {
            "type": "string",
            "description": "One or more IFSC Code is appended using a pipe separator (|)",
            "examples": [
              "KKBK0006749|HDFC000231|SBIN213213213"
            ]
          }
        }
      },
      "content-type": {
        "title": "content-type",
        "const": "application/x-www-form-urlencoded",
        "type": "string",
        "examples": [
          "application/x-www-form-urlencoded"
        ]
      },
      "key": {
        "title": "key",
        "const": "JPM7Fg",
        "type": "string",
        "description": "The merchant key provided by PayU must be included.",
        "examples": [
          "JPM7Fg"
        ]
      }
    }
  },
  "tags": [
