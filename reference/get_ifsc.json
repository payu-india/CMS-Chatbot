        ],
        "summary": "GetIFSCDetailsAPI",
        "description": "",
        "operationId": "GetIFSCDetailsAPI",
        "parameters": [
          {
            "name": "ifsc",
            "in": "query",
            "description": "Indicates the IFSC Code of the bank to fetch the associated beneficiary details",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "examples": [
