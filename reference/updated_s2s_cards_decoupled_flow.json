            ]
          },
          "deviceChannel": {
            "type": "string",
            "description": "The channel of transaction is to be specified in this field.",
            "examples": [
              "APP/BRW"
            ]
          }
        },
        "description": "This parameter contains the following fields in an array format. Note: This parameter is applicable for the EMV 3DS transactions."
      },
      "additionalinfo": {
        "title": "additionalinfo",
        "type": "object",
