  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "https://test.payu.in/",
      "variables": {}
    },
    {
      "url": "https://mobiletest.payu.in/merchant",
      "variables": {}
    },
    {
      "url": "https://sboxmercury.citruspay.com/multi-currency-pricing/mcp",
      "variables": {}
    },
    {
      "url": "https://test.payu.in",
      "variables": {}
    }
