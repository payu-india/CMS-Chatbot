      "authentication_info": {
        "title": "authentication_info",
        "required": [
          "eci",
          "cavv",
          "flowType",
          "threeDSTransID",
          "threeDSServerTransID",
          "threeDSTransStatus",
          "threeDSTransStatusReason",
          "additionalinfo",
          "acquirer_bin"
        ],
        "type": "object",
        "properties": {
          "eci": {
            "type": "string",
            "description": "The electronic commerce indicator is used in payer authentication to indicate the level of security used when the cardholder provided payment information to the merchant. Its value corresponds to the authentication result and the characteristics of the merchant checkout process.",
            "examples": [
              "05"
            ]
          },
          "cavv": {
            "type": "string",
            "description": "The Cardholder Authentication Verification Value (CAVV) is specified here.",
            "examples": [
              "AAABAWFlmQAAAABjRWWZEEFgFz"
            ]
          },
          "flowType": {
            "type": "string",
            "description": "This field must contain any of the following flow types: Frictionless or Challenge",
            "examples": [
              "Frictionless"
            ]
          },
          "threeDSTransID": {
            "type": "string",
            "description": "This field must contain the 3DS transaction ID.",
            "examples": [
              "67b4c71f-19bf-4d97-bd09-4e3687dc9e42"
            ]
          },
          "threeDSServerTransID": {
            "type": "string",
            "description": "This field must contain the 3DS transaction ID.",
            "examples": [
              "eea30d14-71cf-41af-b961-f95b7d67dc93"
            ]
          },
          "threeDSTransStatus": {
            "type": "string",
            "description": "This field must contain the 3DS transaction status. It can be any of the following: Y, N, U or R",
            "examples": [
              "Y"
            ]
          },
          "threeDSTransStatusReason": {
            "type": "string",
            "description": "This field must contain the 3DS transaction reason. It can be an integer in the range 0-99.",
            "examples": [
              "01"
            ]
          },
          "additionalinfo": {
            "type": "string",
            "description": "This field must contain the additional information in aJSON format."
          },
          "acquirer_bin": {
            "type": "string",
            "description": "This field must contain the Bank Identification Number (BIN) that is used to clear and settle the transaction within Visa and the country in which it is licensed for use..",
            "examples": [
              "401200"
            ]
          }
        },
        "description": "This parameter contains the authentication information in a JSON format for direct authorization."
      },
      "threeDS2RequestData": {
        "title": "threeDS2RequestData",
        "required": [
          "threeDSVersion",
          "deviceChannel"
