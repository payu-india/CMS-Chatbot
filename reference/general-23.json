{
  "openapi": "3.1.0",
  "info": {
    "title": "General",
    "contact": {},
    "version": "1.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "https://test.payu.in/merchant",
      "variables": {}
    }
  ],
  "paths": {
    "/postservice.php": {
      "parameters": []
    }
  },
  "components": {
    "schemas": {
      "var1": {
        "title": "var1",
        "required": [
          "requestId",
          "transactionDetails",
          "usecase",
          "filters",
          "useCase"
        ],
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "This parameter must contain the request ID."
          },
          "transactionDetails": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TransactionDetails"
              },
              {
                "description": "This parameter must contain the amount and txnid in a JSON format."
              }
            ]
          },
          "usecase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/useCase"
              },
              {
                "description": "This field contains list of fields for which you want get information."
              }
            ]
          },
          "filters": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Filters"
              },
              {
                "description": "This parameter is used to filter the response of this API based on payment option, offer type, etc."
              }
            ]
          },
          "useCase": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UseCase"
              },
              {}
            ]
          }
        }
      },
      "TransactionDetails": {
        "title": "TransactionDetails",
        "required": [
          "amount"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "string"
          }
        },
        "examples": [
          {
            "amount": "28900"
          }
        ]
      },
      "useCase": {
        "title": "useCase",
        "required": [
          "getExtendedPaymentDetails",
          "getAdditionalCharges",
          "getTaxSpecification",
          "checkDownStatus"
        ],
        "type": "object",
        "properties": {
          "getExtendedPaymentDetails": {
            "type": "string",
            "description": "This flag is posted as true to check EMI eligibility based on mobile number and/or card number depending on the payment method used. Also, checks the eligibility for “Buy Now Pay Later” payment modes.",
            "examples": [
              "true"
            ]
          },
          "getAdditionalCharges": {
            "type": "string",
            "description": "This flag is posted as true to return the additional charges configured for all payment options.",
            "examples": [
              "true"
            ]
          },
          "getTaxSpecification": {
            "type": "string",
            "description": "This flag is posted as true to returns the tax specification configured on the backend. Clients can use the result to show the split of additional charges for each payment option.",
            "examples": [
              "true"
            ]
          },
          "checkDownStatus": {
            "type": "string",
            "description": "This flag is posted as true to return the downtime of the payment options.",
            "examples": [
              "true"
            ]
          }
        },
        "description": ""
      },
      "Filters": {
        "title": "Filters",
        "required": [
          "paymentOptions"
        ],
        "type": "object",
        "properties": {
          "paymentOptions": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PaymentOptions"
              },
              {}
            ]
          }
        },
        "examples": [
          {
            "paymentOptions": {
              "emi": {
                "dc": "ICIC"
              }
            }
          }
        ]
      },
      "PaymentOptions": {
        "title": "PaymentOptions",
        "required": [
          "emi"
        ],
        "type": "object",
        "properties": {
          "emi": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Emi"
              },
              {}
            ]
          }
        },
        "examples": [
          {
            "emi": {
              "dc": "ICIC"
            }
          }
        ]
      },
      "Emi": {
        "title": "Emi",
        "required": [
          "dc"
        ],
        "type": "object",
        "properties": {
          "dc": {
            "type": "string"
          }
        },
        "examples": [
          {
            "dc": "ICIC"
          }
        ]
      },
      "UseCase": {
        "title": "UseCase",
        "required": [
          "checkCustomerEligibility"
        ],
        "type": "object",
        "properties": {
          "checkCustomerEligibility": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Misc",
      "description": ""
    }
  ],
  "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
  }
}