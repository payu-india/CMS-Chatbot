{
  "openapi": "3.0.0",
  "info": {
    "title": "Payment Links API",
    "version": "1.0.0",
    "description": "API for creating and managing payment links"
  },
  "servers": [
    {
      "url": "https://api.example.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/payment-links": {
      "post": {
        "summary": "Create payment link",
        "description": "Create a new payment link with specified parameters",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentLinkRequest"
              },
              "example": {
                "isPartialPaymentAllowed": true,
                "maxPaymentsAllowed": 5,
                "isAmountFilledByCustomer": false,
                "minAmountForCustomer": 10,
                "subAmount": 100,
                "description": "Payment for services",
                "invoiceNumber": "INV123456",
                "expiryDate": "2024-12-31 23:59:59",
                "tax": "10",
                "source": "API",
                "currency": "INR",
                "customer": {
                  "name": "John Doe",
                  "phone": "9999999999",
                  "email": "john.doe@example.com"
                },
                "address": {
                  "line1": "123 Main Street",
                  "line2": "Apt 4B",
                  "city": "Mumbai",
                  "state": "Maharashtra",
                  "country": "India",
                  "zipCode": "400001"
                },
                "udf1": "Custom field 1",
                "udf2": "Custom field 2",
                "udf3": "Custom field 3",
                "udf4": "Custom field 4",
                "udf5": "Custom field 5",
                "viaEmail": 1,
                "viaSms": 1,
                "shippingCharge": "20"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment link created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "paymentLink": {
                      "type": "string"
                    },
                    "linkId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatePaymentLinkRequest": {
        "type": "object",
        "required": [
          "isPartialPaymentAllowed",
          "subAmount",
          "description",
          "invoiceNumber",
          "expiryDate",
          "tax",
          "source",
          "customer"
        ],
        "properties": {
          "isPartialPaymentAllowed": {
            "type": "boolean",
            "description": "This parameter contains any of the following: true-The part payment is enabled false-The part payment is not enabled",
            "example": true
          },
          "maxPaymentsAllowed": {
            "type": "integer",
            "description": "This parameter is used to specify the number of payments that can be accepted on a link.",
            "example": 5
          },
          "isAmountFilledByCustomer": {
            "type": "boolean",
            "description": "This parameter is set to true if the amount has to be entered by your customer in the payment link page.",
            "example": false
          },
          "minAmountForCustomer": {
            "type": "integer",
            "description": "This parameter contains the minimum amount a customer needs to pay in case of partial payment.",
            "example": 10
          },
          "subAmount": {
            "type": "integer",
            "description": "This parameter must contain the payment amount.",
            "example": 100
          },
          "description": {
            "type": "string",
            "description": "This parameter must contain the description or purpose of creating the payment link.",
            "example": "Payment for services"
          },
          "invoiceNumber": {
            "type": "string",
            "description": "This parameter contains the unique string which is used for identifying a payment link. This must be alphanumeric.",
            "example": "INV123456"
          },
          "expiryDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "description": "This parameter contains the expiry date of the payment link. This must be in yyyy-MM-dd HH:mm:ss format (will be 365 days in all other cases).",
            "example": "2024-12-31 23:59:59"
          },
          "tax": {
            "type": "string",
            "description": "This parameter contains the tax amount for the payment transaction. This value must be greater than zero.",
            "example": "10"
          },
          "source": {
            "type": "string",
            "description": "This parameter contains the source of payment generation.",
            "example": "API"
          },
          "currency": {
            "type": "string",
            "description": "This parameter contains the currency used for collecting the amount.",
            "example": "INR"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "udf1": {
            "type": "string",
            "description": "User-defined fields (udf) are used to store any information corresponding to a particular transaction. You can use up to five udfs in the post designated as udf1, udf2, udf3, udf4, udf5.",
            "example": "Custom field 1"
          },
          "udf2": {
            "type": "string",
            "description": "User-defined fields (udf) are used to store any information corresponding to a particular transaction. You can use up to five udfs in the post designated as udf1, udf2, udf3, udf4, udf5.",
            "example": "Custom field 2"
          },
          "udf3": {
            "type": "string",
            "description": "User-defined fields (udf) are used to store any information corresponding to a particular transaction. You can use up to five udfs in the post designated as udf1, udf2, udf3, udf4, udf5.",
            "example": "Custom field 3"
          },
          "udf4": {
            "type": "string",
            "description": "User-defined fields (udf) are used to store any information corresponding to a particular transaction. You can use up to five udfs in the post designated as udf1, udf2, udf3, udf4, udf5.",
            "example": "Custom field 4"
          },
          "udf5": {
            "type": "string",
            "description": "User-defined fields (udf) are used to store any information corresponding to a particular transaction. You can use up to five udfs in the post designated as udf1, udf2, udf3, udf4, udf5.",
            "example": "Custom field 5"
          },
          "viaEmail": {
            "type": "integer",
            "description": "This parameter is set to 1 to send the payment link via the email upon generation. Else, set to 0 (zero) so that email is not sent.",
            "enum": [
              0,
              1
            ],
            "example": 1
          },
          "viaSms": {
            "type": "integer",
            "description": "This parameter is set to 1 to send the payment link via the SMS upon generation. Else, set to 0 (zero) so that SMS is not sent.",
            "enum": [
              0,
              1
            ],
            "example": 1
          },
          "shippingCharge": {
            "type": "string",
            "description": "This parameter must contain the shipping charges",
            "example": "20"
          }
        }
      },
      "Customer": {
        "type": "object",
        "required": [
          "name",
          "phone",
          "email"
        ],
        "description": "Customer object containing customer information",
        "properties": {
          "name": {
            "type": "string",
            "description": "Customer name",
            "example": "John Doe"
          },
          "phone": {
            "type": "string",
            "description": "Customer phone number",
            "example": "9999999999"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Customer email address",
            "example": "john.doe@example.com"
          }
        }
      },
      "Address": {
        "type": "object",
        "required": [
          "line1",
          "city",
          "state",
          "country",
          "zipCode"
        ],
        "description": "This parameter contains the customer address to which the goods are delivered.",
        "properties": {
          "line1": {
            "type": "string",
            "description": "Address line 1",
            "example": "123 Main Street"
          },
          "line2": {
            "type": "string",
            "description": "Address line 2",
            "example": "Apt 4B"
          },
          "city": {
            "type": "string",
            "description": "City",
            "example": "Mumbai"
          },
          "state": {
            "type": "string",
            "description": "State",
            "example": "Maharashtra"
          },
          "country": {
            "type": "string",
            "description": "Country",
            "example": "India"
          },
          "zipCode": {
            "type": "string",
            "description": "ZIP/Postal code",
            "example": "400001"
          }
        }
      }
    }
  }
}