{
  "openapi": "3.1.0",
  "info": {
    "title": "E-Sign Merchant Agreement API",
    "version": "1.0.0",
    "description": "API for e-signing merchant agreements using OTP verification"
  },
  "servers": [
    {
      "url": "https://uatoneapi.payu.in",
      "description": "UAT E-sign flows API server"
    }
  ],
  "paths": {
    "/v3/merchants/{merchant_uuid}/agreements/{agreement_uuid}/esign": {
      "post": {
        "operationId": "EsignMerchantAgreement",
        "summary": "E-Sign Merchant Agreement",
        "description": "E-signs a merchant agreement using the OTP sent to the signatory",
        "parameters": [
          {
            "name": "merchant_uuid",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the merchant",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "agreement_uuid",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the agreement document",
            "schema": {
              "type": "string",
              "default": ""
            }
          }
        ],
        "requestBody": {
          "description": "Request body for e-signing the merchant agreement",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "otp": {
                    "type": "string",
                    "description": "One-time password received by the signatory"
                  },
                  "otp_reference_id": {
                    "type": "string",
                    "description": "Reference ID received when OTP was sent"
                  },
                  "signatory_email": {
                    "type": "string",
                    "description": "Email address of the signatory"
                  },
                  "signatory_name": {
                    "type": "string",
                    "description": "Name of the signatory"
                  },
                  "signatory_ip": {
                    "type": "string",
                    "description": "IP address of the signatory"
                  },
                  "consent": {
                    "type": "boolean",
                    "description": "Indicates whether the signatory has given consent for e-signing"
                  }
                },
                "required": [
                  "otp",
                  "otp_reference_id",
                  "signatory_email",
                  "signatory_name",
                  "consent"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agreement e-signed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "Status of the e-signing operation"
                    },
                    "message": {
                      "type": "string",
                      "description": "Message about the e-signing operation"
                    },
                    "signed_agreement_url": {
                      "type": "string",
                      "description": "URL to download the signed agreement",
                      "format": "uri"
                    },
                    "signed_timestamp": {
                      "type": "string",
                      "description": "Timestamp when the agreement was signed",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request, validation error, or invalid OTP"
          },
          "401": {
            "description": "Unauthorized - OTP verification failed"
          },
          "404": {
            "description": "Merchant or agreement not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/oauth/token": {
      "post": {
        "tags": [
          "Send and verify"
        ],
        "summary": "GetToken",
        "operationId": "GetToken",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "encoding": {},
              "schema": {
                "required": [
                  "client_id",
                  "client_secret",
                  "grant_type",
                  "scope"
                ],
                "type": "object",
                "properties": {
                  "client_id": {
                    "type": "string",
                    "description": "uat",
                    "examples": [
                      "56b16b8f4d16f61929d6596d3c9cfb3e9bfc526c9c906b09c916cc9ea591b66d"
                    ]
                  },
                  "client_secret": {
                    "type": "string",
                    "description": "uat",
                    "examples": [
                      "f5e0115d5b9f715ce0e8c4ef99d438aa4e7f0203f6e1d5e9be9e36f80a07716b"
                    ]
                  },
                  "grant_type": {
                    "type": "string",
                    "examples": [
                      "client_credentials"
                    ]
                  },
                  "scope": {
                    "type": "string",
                    "examples": [
                      "send_sign_in_otp verify_sign_in_otp refer_merchant"
                    ]
                  }
                },
                "contentMediaType": "application/x-www-form-urlencoded"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {}
          }
        },
        "deprecated": false,
        "servers": [
          {
            "url": "https://uat-accounts.payu.in",
            "variables": {}
          }
        ]
      },
      "parameters": []
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "httpBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "httpBearer": []
    }
  ]
}